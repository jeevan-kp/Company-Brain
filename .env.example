# ============================================================================
# Company Brain — Environment Configuration (Team 20)
# ============================================================================

# LLM Provider Options: 'openrouter', 'groq', 'huggingface', 'azure', or 'local_engine'
# Leave empty or omit to autodetect based on which API key is provided below.
LLM_PROVIDER=

# Option 1: OpenRouter (Supports FREE models like LLaMA-3.3-70B, DeepSeek-R1)
# Get a free key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Option 2: Groq Cloud (Free tier, ultra-fast LLaMA models)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option 3: Hugging Face (Free Serverless Inference API)
# Get a free token at: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Option 4: Azure OpenAI (Azure AI Foundry - Production)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_FAST_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Database Configuration (PostgreSQL 17 + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hackathon_team_20
PGHOST=localhost
PGPORT=5432
PGDATABASE=hackathon_team_20
PGUSER=postgres
PGPASSWORD=postgres

# Connection Pool Settings (Azure production constraint: max 3 connections)
PG_MAX_CONNECTIONS=3
PG_IDLE_TIMEOUT_MS=10000
PG_CONNECTION_TIMEOUT_MS=5000
PGSSLMODE=disable

# API Server
PORT=3001
NODE_ENV=development
