{
  "name": "company-brain-agent",
  "version": "1.0.0",
  "description": "Company Brain — PostgreSQL 17 + pgvector & Azure OpenAI LangGraph Agent (Team 20)",
  "main": "server/src/app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/src/app.js",
    "dev": "nodemon server/src/app.js",
    "db:migrate": "node scripts/db_reset.js --migrate-only",
    "db:reset": "node scripts/db_reset.js",
    "generate-mocks": "node scripts/generators/gen_all_mocks.js",
    "seed": "node scripts/loaders/load_all.js",
    "embed": "node scripts/embed_chunks.js",
    "verify": "node scripts/verify.js",
    "eval": "node scripts/eval.js",
    "all": "npm run db:reset && npm run generate-mocks && npm run seed && npm run embed && npm run verify"
  },
  "dependencies": {
    "@langchain/core": "^0.3.38",
    "@langchain/langgraph": "^0.2.45",
    "@langchain/openai": "^0.4.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "lru-cache": "^10.2.0",
    "openai": "^4.85.4",
    "pg": "^8.13.1",
    "pgvector": "^0.2.0",
    "puppeteer-core": "^25.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
